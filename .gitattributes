# Normalize line endings for all text files
* text=auto

# C# source files
*.cs text diff=csharp

# Project files
*.csproj text
*.slnx text

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Markdown
*.md text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
